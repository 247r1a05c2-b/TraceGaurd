# TraceGaurd enterprise backend configuration
# Never commit real secrets or real database URLs.

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Distributed cache and rate limiting when running multiple API replicas
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=240
WEB_CONCURRENCY=2

# Application/session security
TRACEGAURD_SECRET=replace-with-a-long-random-secret
TRACEGAURD_CLIENT_INGEST_SECRET=replace-with-a-different-long-random-secret
SESSION_HOURS=12

# Initial software-engineer account
DEMO_ENGINEER_EMAIL=engineer@tracegaurd.ai
DEMO_ENGINEER_PASSWORD=replace-with-a-strong-password

# Gemini LLM used by the LangGraph Root Cause and Diagnostic agents
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
