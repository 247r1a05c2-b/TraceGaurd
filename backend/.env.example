# TraceGaurd production/local backend configuration
# Never commit real secrets or real database URLs.

# Neon PostgreSQL pooled connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Application/session security
TRACEGAURD_SECRET=replace-with-a-long-random-secret
TRACEGAURD_CLIENT_INGEST_SECRET=replace-with-a-different-long-random-secret
SESSION_HOURS=12

# Initial software-engineer account. The password is hashed before persistence.
DEMO_ENGINEER_EMAIL=engineer@tracegaurd.ai
DEMO_ENGINEER_PASSWORD=replace-with-a-strong-password

# LLM configuration. The app uses deterministic fallbacks when no API key is configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
